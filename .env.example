# rename this file to .env and supply the values listed below
# also make sure they are available to the build tool (e.g. Netlify)
# warning: variables prefixed with NEXT_PUBLIC_ will be made available to client-side code
# be careful not to expose sensitive data (in this case your Algolia admin key)

# Algolia Insights (search click tracking). Must be the same application and a
# valid key for the index @sentry-internal/global-search queries, or every click
# event is rejected with a 401.
NEXT_PUBLIC_ALGOLIA_APP_ID=OOK48W9UCL
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=2d64ec1106519cbc672d863b0d200782
NEXT_PUBLIC_SENTRY_DSN=

# Fin Ask AI pilot. All values below are server-only; never add NEXT_PUBLIC_.
# Kapa remains the default until the deployment is deliberately switched.
ASK_AI_PROVIDER=kapa
FIN_PILOT_ENABLED=false
FIN_PUBLIC_ORIGIN=http://localhost:3000
FIN_AGENT_API_KEY=
FIN_REGION=us
# Optional Fin for Platforms environment ID (not a Messenger installation).
FIN_ENVIRONMENT=
# Enable SSE + streaming in Fin, then verify its exact regional hostname.
FIN_SSE_HOSTS=primary-realtime.intercom-messenger.com
# Optional for a protected Vercel preview or local development. Without Redis,
# signed conversation tokens stay in page memory; no extra secrets are needed.
# Required for production, shared limits, feedback export, and direct handoff.
# No silent fallback if either value is configured but Redis is unavailable.
FIN_REDIS_REST_URL=
FIN_REDIS_REST_TOKEN=
# Applied only when Redis is configured.
FIN_DAILY_TURN_LIMIT=100
# Optional later: feedback pipeline (requires Redis).
# Fin Agent API webhook secret, distinct from a standard Intercom app secret.
FIN_WEBHOOK_SECRET=
# Random 32+ character bearer token for the internal event export endpoint.
FIN_EVENTS_READ_TOKEN=
# Set only after testing the actual support handoff and follow-up workflow.
FIN_HANDOFF_ENABLED=false
ASK_AI_SUPPORT_URL=
